# Fire DEX - backend environment variables
#
# HOW TO USE:
#   1. Copy this file to `.env` in the same folder
#   2. Fill in real values
#   3. NEVER commit `.env` -- it is already in .gitignore
#
# There are no secrets in this file, and there never will be. It exists so
# that anyone cloning the repo knows exactly what needs to be provided.

# --- Safety regime -------------------------------------------------
# development | testnet | production
# Keep this on `development` unless you specifically intend otherwise.
APP_MODE=development

# --- Server --------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DEBUG=true

# --- Logging -------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# false = readable coloured logs locally, true = one JSON object per line
LOG_JSON=false

# --- CORS ----------------------------------------------------------
# Where the frontend runs. Comma-separated for multiple origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ------------------------------------------------------
# SQLite for the prototype (no Docker required).
# For PostgreSQL later:
#   DATABASE_URL=postgresql+psycopg://firedex:firedex@localhost:5432/firedex
DATABASE_URL=sqlite+aiosqlite:///./data/firedex.db


# ===================================================================
# NOT USED YET -- added in later milestones. Listed here so you know
# which accounts to create in advance.
# ===================================================================

# --- Blockchain RPC (Milestone 2) ----------------------------------
# https://alchemy.com  -- free tier
# ALCHEMY_API_KEY=
# ETHEREUM_RPC_URL=
# SEPOLIA_RPC_URL=

# --- Block explorer data (Milestone 2) -----------------------------
# https://etherscan.io/apis  -- free tier
# ETHERSCAN_API_KEY=

# --- Market data (Milestone 3) -------------------------------------
# https://coingecko.com/api  -- free demo key
# COINGECKO_API_KEY=

# --- AI providers (Milestone 6) ------------------------------------
# Online provider, e.g. https://console.groq.com
# GROQ_API_KEY=
# Local provider
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=
