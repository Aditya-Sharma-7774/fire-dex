# Fire DEX - backend environment variables
#
#   1. Copy this file to `.env` in the same folder
#   2. Fill in the values you need; everything else has a working default
#   3. NEVER commit `.env` -- it is already in .gitignore
#
# Every setting below is read by the backend. Nothing is listed that the
# code ignores. The host and port are set by START.bat, not here.

# --- Safety regime -------------------------------------------------
# development | testnet | production
# production also disables the interactive API docs at /docs.
APP_MODE=development

# --- Logging -------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# false = readable coloured logs, true = one JSON object per line
LOG_JSON=false

# --- Access control ------------------------------------------------
# Browser origins allowed to call the API (the frontend).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Host headers the server answers. Guards against DNS rebinding.
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database ------------------------------------------------------
# SQLite needs no setup. For PostgreSQL:
#   DATABASE_URL=postgresql+psycopg://firedex:firedex@localhost:5432/firedex
DATABASE_URL=sqlite+aiosqlite:///./data/firedex.db

# --- Blockchain data -----------------------------------------------
# All default to verified public keyless endpoints, which are rate limited.
# Set your own for heavier use (Alchemy, Infura, Helius all have free tiers).
# ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# BSC_RPC_URL=https://bsc-rpc.publicnode.com
# The official Solana endpoint allows token-account lookups only one call at
# a time and about ten per window; Helius is the easy upgrade if you hit it.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Bitcoin: Esplora-compatible APIs, comma-separated, tried in order.
# BITCOIN_API_URLS=https://mempool.space/api,https://blockstream.info/api

# --- AI providers --------------------------------------------------
# Tried in order, failing over automatically on a rate limit or outage:
#   online:  Groq -> Gemini -> Ollama
#   local:   Ollama -> Groq -> Gemini
LLM_PREFERENCE=online

# Free tier: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Free tier: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Local and private. Requires Ollama running with the model pulled:
#   ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# How many times the reviewer may send an analysis back for another pass.
MAX_REANALYSIS_ATTEMPTS=1
