# Fire DEX - frontend environment variables
#
# Copy to `.env` and adjust if needed.
#
# WARNING: anything prefixed with VITE_ is compiled into the browser bundle
# and is therefore PUBLIC. Never put an API key or secret in this file.
# All keyed third-party APIs are called from the backend for exactly this
# reason.

VITE_API_URL=http://127.0.0.1:8000
